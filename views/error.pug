doctype html
html
  head
    meta(charset="utf-8")
    title= title || "Error"
    style.
      body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; display: flex;
             align-items: center; justify-content: center; height: 100vh; margin: 0;
             background: #f6f7f9; color: #222; }
      .card { background: #fff; padding: 32px 40px; border-radius: 10px;
              box-shadow: 0 4px 20px rgba(0,0,0,0.08); max-width: 480px; text-align: center; }
      code { background: #eef1f4; padding: 2px 6px; border-radius: 4px; font-size: 14px; }
  body
    .card
      h1= title || "Something went wrong!"
      p= msg || "Please try again later."
